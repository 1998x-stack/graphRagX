# graphRagX v2
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Safe defaults: no paid/network calls until explicitly enabled.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=hash

# OpenAI provider configuration (only required when provider=openai)
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4000

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=256
EMBEDDING_BATCH_SIZE=64

MAX_CONCURRENCY=4
MAX_RETRY=3
RETRY_DELAY=1.0

CHUNK_SIZE=1000
CHUNK_OVERLAP=160
MAX_ENTITIES_PER_CHUNK=20
MAX_RELATIONS_PER_CHUNK=30

COMMUNITY_ALGORITHM=louvain
LEIDEN_RESOLUTION=1.0
LEIDEN_SEED=42

RETRIEVAL_NEIGHBOR_DEPTH=1
GLOBAL_TOP_K=8
MAX_QUERY_TOP_K=50
MAX_CONTEXT_CHUNKS=12

MAX_DOCUMENTS=200
MAX_DOCUMENT_CHARS=500000
MAX_QUERY_CHARS=8000

ENABLE_STREAM=false
STREAM_LOG_ENABLED=false
STORE_LLM_PAYLOADS=false

OUTPUT_DIR=./outputs
LOG_LEVEL=INFO
LOG_FILE=./logs/graphrag.log
LOG_ROTATION=100 MB
LOG_RETENTION=10 days
