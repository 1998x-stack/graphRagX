# GraphRAG Configuration Template
# Copy this file to .env and fill in your values

# ==================== API Configuration ====================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ==================== LLM Configuration ====================
# TODO: Fill in your LLM API credentials
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=  # Optional: custom base URL
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4000

# ==================== Embedding Configuration ====================
# TODO: Fill in your embedding API credentials
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_DIMENSION=1536

# ==================== Concurrency Configuration ====================
MAX_CONCURRENCY=2
MAX_RETRY=3
RETRY_DELAY=1.0

# ==================== Chunking Configuration ====================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==================== Extraction Configuration ====================
MAX_ENTITIES_PER_CHUNK=20
MAX_RELATIONS_PER_CHUNK=20

# ==================== Community Detection ====================
LEIDEN_RESOLUTION=1.0
LEIDEN_MAX_ITERATIONS=100
LEIDEN_SEED=42

# ==================== Streaming Configuration ====================
ENABLE_STREAM=false
STREAM_LOG_ENABLED=true

# ==================== Storage Configuration ====================
OUTPUT_DIR=./outputs

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/graphrag.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days