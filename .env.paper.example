# Reproducibility-oriented GraphRAG paper-method preset.
# Copy selected lines into .env. This is NOT a reproduction of the paper's
# original dataset/model/version/cost, and does not contain credentials.
#
# Requires: pip install -r requirements.txt -r requirements-leiden.txt
#
# Use real providers only when API credentials and budget controls are set:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=

CHUNK_UNIT=tokens
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_ENTITIES_PER_CHUNK=20
MAX_RELATIONS_PER_CHUNK=30

COMMUNITY_ALGORITHM=leiden
COMMUNITY_MAX_LEVELS=4
LEIDEN_SEED=42

GLOBAL_SELECTION_MODE=coverage
GLOBAL_SHUFFLE_SEED=42
GLOBAL_MAX_REPORTS=256
GLOBAL_MIN_REPORT_TOKENS=16
GLOBAL_MAX_DATA_TOKENS=8000
GLOBAL_MAP_BATCH_TOKENS=2000
GLOBAL_REDUCE_DATA_TOKENS=4000

TS_MAX_TEXT_UNITS=256
TS_MAX_DATA_TOKENS=8000

# This project's /index API still has request/size limits. A million-token
# paper corpus requires separate ingestion and large-index infrastructure.
# The offline mock model is only a smoke-test provider.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=hash
